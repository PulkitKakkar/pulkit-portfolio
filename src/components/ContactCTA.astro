---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside>
	<div>
		<p>Available for the right technical leadership conversations</p>
		<h2>Need help shaping or delivering a technical solution?</h2>
	</div>
	<div class="actions">
		<CallToAction href="mailto:pulkitkakkar176@gmail.com">
			Email Me
			<Icon icon="paper-plane-tilt" size="1.2em" />
		</CallToAction>
		<a class="secondary" href="https://www.linkedin.com/in/pulkit-kakkar-b98408b1/">
			LinkedIn
			<Icon icon="linkedin-logo" size="1.1em" />
		</a>
	</div>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 2rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 5rem 1.5rem;
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--accent-regular) 12%, transparent), transparent),
			var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	h2 {
		font-size: var(--text-xl);
		max-width: 18ch;
	}

	p {
		margin-bottom: 0.75rem;
		color: var(--accent-regular);
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem;
	}

	.secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		border: 1px solid var(--gray-700);
		border-radius: 999rem;
		padding: 0.9rem 1.25rem;
		color: var(--gray-0);
		font-family: var(--font-brand);
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color var(--theme-transition),
			color var(--theme-transition),
			transform var(--theme-transition);
	}

	.secondary:hover,
	.secondary:focus {
		border-color: var(--accent-regular);
		color: var(--accent-regular);
		transform: translateY(-0.125rem);
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: center;
		}

		h2 {
			font-size: var(--text-3xl);
		}
	}
</style>
