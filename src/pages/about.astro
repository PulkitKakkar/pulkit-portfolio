---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="About | Pulkit Kakkar" description="Technical Design Lead focused on end-to-end solution design, Angular, payments, architecture, and delivery.">
  <div class="stack gap-20">
    <main class="wrapper about">
      <Hero
          title="About"
          tagline="I design and deliver practical technical solutions across customer journeys, integrations, and engineering teams."
      >
        <img
            width="1553"
            height="873"
            src="/assets/at-work.jpeg"
            alt="Pulkit Kakkar at work with a colleague"
        />
      </Hero>

      <section>
        <h2 class="section-title">Background</h2>
        <div class="content">
          <p>
            I am a Technical Design Lead originally from India and currently based in the UK, with 8+ years of hands-on experience delivering customer-facing digital products.
          </p>
          <br/>
          <p>
            My background is rooted in Angular, React, TypeScript, JavaScript, RxJS, and AWS, and my role has grown from frontend delivery into end-to-end technical design. At British Airways, I look after technical design and delivery across the classic booking and payment journey, working across frontend, backend, payments, CMS integrations, production support, and technical governance.
          </p>
          <br/>
          <p>
            I help teams align architecture, slice work clearly, identify dependencies, manage blockers, and keep solutions maintainable. That includes understanding secure payment flows such as 3DS, tokenisation, authorization, orchestration, and third-party integrations, supporting CMS-driven content such as co-brand card offers and contextual promotions, investigating production issues through logs, Splunk, transaction IDs, MRNs, and session IDs, and supporting vulnerability management, technical risk, managed service transition, and knowledge handover.
          </p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Education</h2>
        <div class="content">
          <p>I completed my higher education in India, graduating in 2017 with a Bachelor of Technology degree in
            Computer Science and Engineering from the esteemed Dr. A. P. J. Abdul Kalam Technical University. This educational
            foundation has provided me with a strong basis in various aspects of computer science, which I have
            continuously applied and expanded upon in my professional career.</p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Skills</h2>
        <div class="content">
          <ul>
            <li>Angular</li>
            <li>React & Vite</li>
            <li>JavaScript / TypeScript</li>
            <li>RxJS</li>
            <li>HTML5 / CSS3</li>
            <li>End-to-End Solution Design</li>
            <li>Frontend & Backend Architecture Alignment</li>
            <li>Secure Payment Flows, 3DS, Tokenisation & Authorization</li>
            <li>AEM / CMS Integrations</li>
            <li>Technical Readiness & Delivery Planning</li>
            <li>Production Support, Logs & Splunk Investigation</li>
            <li>Vulnerability Management & Technical Governance</li>
            <li>Code Quality, Maintainability & Engineering Standards</li>
            <li>Shopify (Liquid, Theme Customization)</li>
            <li>Google Apps Script</li>
            <li>Amazon Web Services (AWS)</li>
            <li>OpenAI / GPT Integration</li>
            <li>Splunk (Dashboards & Observability)</li>
            <li>Cypress & Automation Testing</li>
            <li>Adobe Target (A/B Testing)</li>
            <li>Firebase</li>
          </ul>
        </div>
      </section>
    </main>
    <ContactCTA/>
  </div>
</BaseLayout>

<style>
    .about {
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
    }

    img {
        margin-top: 1.5rem;
        border-radius: 1.5rem;
        box-shadow: var(--shadow-md);
    }

    section {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        color: var(--gray-200);
    }

    .section-title {
        grid-column-start: 1;
        font-size: var(--text-xl);
        color: var(--gray-0);
    }

    .content {
        grid-column: 2 / 4;
    }

    .content :global(a) {
        text-decoration: 1px solid underline transparent;
        text-underline-offset: 0.25em;
        transition: text-decoration-color var(--theme-transition);
    }

    .content :global(a:hover),
    .content :global(a:focus) {
        text-decoration-color: currentColor;
    }

    @media (min-width: 50em) {
        .about {
            display: grid;
            grid-template-columns: 1fr 60% 1fr;
        }

        .about > :global(:first-child) {
            grid-column-start: 2;
        }

        section {
            display: contents;
            font-size: var(--text-lg);
        }
    }
</style>
