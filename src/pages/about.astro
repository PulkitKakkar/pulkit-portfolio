---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="About | Pulkit Kakkar" description="Technical Design Lead focused on end-to-end solution design, Angular, payments, architecture, and delivery.">
  <div class="stack gap-10 lg:gap-15">
    <main class="wrapper about">
      <Hero
          title="About"
          tagline="I design and deliver practical technical solutions across customer journeys, integrations, and engineering teams."
      >
        <img
            width="480"
            height="620"
            src="/assets/portrait.jpg"
            alt="Pulkit Kakkar"
        />
      </Hero>

      <section>
        <h2 class="section-title">Background</h2>
        <div class="content">
          <p>
            I am a Technical Design Lead originally from India and currently based in the UK, with 9+ years of hands-on experience delivering customer-facing digital products.
          </p>
          <br/>
          <p>
            My background is rooted in Angular, React, TypeScript, JavaScript, RxJS, and AWS, and my role has grown from frontend delivery into end-to-end technical design. At British Airways, I look after technical design and delivery across the classic booking and payment journey, working across frontend, backend, payments, CMS integrations, production support, and technical governance.
          </p>
          <br/>
          <p>
            I help teams align architecture, slice work clearly, identify dependencies, manage blockers, and keep solutions maintainable. That includes understanding secure payment flows such as 3DS, tokenisation, authorization, orchestration, and third-party integrations, supporting CMS-driven content such as co-brand card offers and contextual promotions, investigating production issues through logs, Splunk, transaction IDs, MRNs, and session IDs, and supporting vulnerability management, technical risk, managed service transition, and knowledge handover.
          </p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Recruiter Snapshot</h2>
        <div class="content snapshot">
          <ul>
            <li><strong>Current focus:</strong> technical design, frontend leadership, booking and payment journeys, CMS integrations, and delivery readiness.</li>
            <li><strong>Strongest fit:</strong> Technical Design Lead, Lead Frontend Engineer, Solution Designer, or frontend-focused Technical Lead roles.</li>
            <li><strong>Working style:</strong> hands-on enough to understand implementation detail, senior enough to align architecture, delivery, and support concerns.</li>
          </ul>
        </div>
      </section>
      <section>
        <h2 class="section-title">Education</h2>
        <div class="content">
          <p>I completed my higher education in India, graduating in 2017 with a Bachelor of Technology degree in
            Computer Science and Engineering from the esteemed Dr. A. P. J. Abdul Kalam Technical University. This educational
            foundation has provided me with a strong basis in various aspects of computer science, which I have
            continuously applied and expanded upon in my professional career.</p>
        </div>
      </section>
      <section>
        <h2 class="section-title">Tech Stack</h2>
        <div class="content stack-grid">
          <article>
            <h3>Frontend</h3>
            <ul>
              <li>Angular</li>
              <li>React</li>
              <li>Vite</li>
              <li>TypeScript</li>
              <li>JavaScript</li>
              <li>RxJS</li>
              <li>HTML5</li>
              <li>CSS3</li>
              <li>Responsive UI</li>
              <li>Accessibility</li>
            </ul>
          </article>
          <article>
            <h3>Architecture & Delivery</h3>
            <ul>
              <li>End-to-End Solution Design</li>
              <li>Frontend & Backend Alignment</li>
              <li>Technical Readiness</li>
              <li>Item Slicing</li>
              <li>Dependency Mapping</li>
              <li>Delivery Governance</li>
              <li>Code Quality</li>
              <li>Maintainability</li>
              <li>Knowledge Handover</li>
            </ul>
          </article>
          <article>
            <h3>Payments & Integrations</h3>
            <ul>
              <li>3DS</li>
              <li>Tokenisation</li>
              <li>Authorization</li>
              <li>Payment Orchestration</li>
              <li>Authentication Adapters</li>
              <li>Integration Boundaries</li>
              <li>AEM / CMS Integrations</li>
              <li>Admin Workflow Design</li>
            </ul>
          </article>
          <article>
            <h3>Tooling, Cloud & Quality</h3>
            <ul>
              <li>AWS</li>
              <li>Firebase</li>
              <li>GitHub</li>
              <li>CI/CD Awareness</li>
              <li>Cypress</li>
              <li>Splunk</li>
              <li>Logs & Observability</li>
              <li>Vulnerability Management</li>
              <li>Production Support</li>
            </ul>
          </article>
          <article>
            <h3>Platforms & AI</h3>
            <ul>
              <li>Shopify</li>
              <li>Liquid</li>
              <li>Google Apps Script</li>
              <li>OpenAI / GPT Integration</li>
              <li>Adobe Target</li>
              <li>A/B Testing</li>
              <li>SEO-aware Site Structure</li>
              <li>Small Business Workflows</li>
            </ul>
          </article>
        </div>
      </section>
    </main>
    <ContactCTA/>
  </div>
</BaseLayout>

<style>
    .about {
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
    }

    img {
        width: min(100%, 32rem);
        aspect-ratio: 4 / 3;
        margin-top: 1.5rem;
        object-fit: cover;
        object-position: center 28%;
        border-radius: 1.5rem;
        box-shadow: var(--shadow-md);
    }

    section {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        color: var(--gray-200);
    }

    .section-title {
        grid-column-start: 1;
        font-size: var(--text-xl);
        color: var(--gray-0);
    }

    .content {
        grid-column: 2 / 4;
    }

    .content :global(a) {
        text-decoration: 1px solid underline transparent;
        text-underline-offset: 0.25em;
        transition: text-decoration-color var(--theme-transition);
    }

    .content :global(a:hover),
    .content :global(a:focus) {
        text-decoration-color: currentColor;
    }

    .snapshot ul {
        display: grid;
        gap: 0.75rem;
        padding-left: 1.2rem;
    }

    .snapshot strong {
        color: var(--gray-0);
    }

    .stack-grid {
        display: grid;
        gap: 1rem;
    }

    .stack-grid article {
        display: grid;
        gap: 0.85rem;
        border: 1px solid var(--gray-800);
        border-radius: 0.75rem;
        padding: 1rem;
        background: color-mix(in srgb, var(--gray-999) 86%, transparent);
        box-shadow: var(--shadow-sm);
    }

    .stack-grid h3 {
        font-size: var(--text-lg);
    }

    .stack-grid ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        padding: 0;
        list-style: none;
    }

    .stack-grid li {
        border: 1px solid var(--gray-800);
        border-radius: 999rem;
        padding: 0.35rem 0.6rem;
        color: var(--gray-300);
        font-size: var(--text-xs);
        line-height: 1;
        background: var(--gray-999_40);
    }

    @media (min-width: 50em) {
        .about {
            display: grid;
            grid-template-columns: 1fr 60% 1fr;
        }

        .about > :global(:first-child) {
            grid-column-start: 2;
        }

        section {
            display: contents;
            font-size: var(--text-lg);
        }

        .stack-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .stack-grid article:first-child,
        .stack-grid article:nth-child(2) {
            grid-column: span 1;
        }

        .stack-grid article:last-child {
            grid-column: 1 / -1;
        }
    }
</style>
