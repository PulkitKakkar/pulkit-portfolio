---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Contact | Pulkit Kakkar"
  description="Contact Pulkit Kakkar for technical design, frontend leadership, architecture, payments, CMS, admin workflow, and delivery conversations."
>
  <main class="wrapper contact-page">
    <Hero
      title="Let’s talk about the technical shape of your next move."
      tagline="I am best suited to conversations where product direction, technical decisions, delivery reality, and maintainability all need to meet."
      align="start"
    />

    <section class="contact-grid" aria-label="Contact options">
      <article class="primary-card">
        <p class="eyebrow">Best route</p>
        <h2>Email</h2>
        <p>
          Share the context, the desired outcome, the current constraint, and
          whether you need design support, implementation support, or both.
        </p>
        <CallToAction href="mailto:pulkitkakkar176@gmail.com">
          Email Pulkit
          <Icon icon="paper-plane-tilt" size="1.2em" />
        </CallToAction>
      </article>

      <div class="links">
        <a href="https://www.linkedin.com/in/pulkit-kakkar-b98408b1/">
          <span>LinkedIn</span>
          <Icon icon="linkedin-logo" size="1.2em" />
        </a>
        <a href="https://github.com/PulkitKakkar">
          <span>GitHub</span>
          <Icon icon="github-logo" size="1.2em" />
        </a>
        <a href="/assets/resume/Pulkit_Kakkar_Technical_Design_Lead_Resume.pdf" download>
          <span>Resume</span>
          <Icon icon="arrow-right" size="1.2em" />
        </a>
      </div>
    </section>

    <section class="fit" aria-labelledby="fit-heading">
      <div>
        <p class="eyebrow">Good fit</p>
        <h2 id="fit-heading">Where I can usually help fastest.</h2>
      </div>
      <ul>
        <li>Turning ambiguous product asks into buildable technical designs.</li>
        <li>Reviewing frontend, backend, CMS, payment, or auth integration boundaries.</li>
        <li>Shaping admin workflows for small businesses and internal teams.</li>
        <li>Improving delivery readiness, handover, maintainability, and support paths.</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-page {
    display: grid;
    gap: 3rem;
  }

  .contact-grid {
    display: grid;
    gap: 1rem;
  }

  .primary-card,
  .fit {
    display: grid;
    gap: 1.25rem;
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    padding: 1.5rem;
    background: var(--gradient-subtle);
    box-shadow: var(--shadow-sm);
  }

  .eyebrow {
    color: var(--accent-regular);
    font-family: var(--font-brand);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h2 {
    font-size: var(--text-2xl);
  }

  .primary-card p:not(.eyebrow),
  .fit li {
    color: var(--gray-400);
    font-size: var(--text-md);
  }

  .links {
    display: grid;
    gap: 0.75rem;
  }

  .links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    padding: 1rem;
    color: var(--gray-0);
    font-family: var(--font-brand);
    font-weight: 600;
    text-decoration: none;
    background: color-mix(in srgb, var(--gray-999) 86%, transparent);
    transition:
      border-color var(--theme-transition),
      color var(--theme-transition),
      transform var(--theme-transition);
  }

  .links a:hover,
  .links a:focus {
    border-color: var(--accent-regular);
    color: var(--accent-regular);
    transform: translateY(-0.125rem);
  }

  .fit ul {
    display: grid;
    gap: 0.85rem;
    padding-left: 1.2rem;
  }

  @media (min-width: 50em) {
    .contact-page {
      gap: 5rem;
    }

    .contact-grid {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: stretch;
    }

    .primary-card,
    .fit {
      border-radius: 1.5rem;
      padding: 2.5rem;
    }

    .fit {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 3rem;
    }
  }
</style>
