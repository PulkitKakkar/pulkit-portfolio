---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';

const projects = (await getCollection('work')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
    title="My Work | Pulkit Kakkar"
    description="Selected work by Pulkit Kakkar across technical design, architecture, delivery, integrations, and product engineering."
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
          title="My Work"
          tagline="Case studies covering technical design, architecture, delivery, integrations, and hands-on product engineering."
          align="start"
      />
      <Grid variant="offset">
        {
          projects.map((project) => (
              <li>
                <PortfolioPreview project={project} />
              </li>
          ))
        }
      </Grid>
    </main>
    <ContactCTA />
  </div>
</BaseLayout>
