---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
const projects = (await getCollection("work")).sort((a,b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0,3);
---
<BaseLayout title="Pulkit Kakkar — Technical Design Lead" description="Technical Design Lead turning complex booking, payment, and digital journeys into clear, buildable systems.">
<main>
  <section class="hero wrapper" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="kicker"><span></span> Technical Design Lead · London, UK</p>
      <h1 id="hero-title">I make complex digital journeys <em>clear enough to ship.</em></h1>
      <p class="intro">I’m Pulkit — a technical design leader bridging product ambition, architecture, and hands-on delivery across booking, payments, and high-traffic customer experiences.</p>
      <div class="hero-actions"><a class="button" href="mailto:pulkitkakkar176@gmail.com">Start a conversation <Icon icon="arrow-right" size="1.1em" /></a><a class="text-link" href="#selected-work">Explore my work <span aria-hidden="true">↓</span></a></div>
    </div>
    <div class="portrait-wrap" aria-label="Portrait of Pulkit Kakkar">
      <div class="portrait-number" aria-hidden="true">09+</div>
      <img src="/assets/portrait.jpg" alt="Pulkit Kakkar smiling" width="600" height="760" />
      <div class="portrait-note"><span class="status-dot"></span><p><strong>Available for the right conversation</strong><br />Technical design · Frontend leadership</p></div>
    </div>
  </section>
  <section class="proof" aria-label="Career highlights"><div class="wrapper proof-grid">
    <p class="proof-lead">From ambiguity<br />to delivery.</p>
    <article><strong>9+</strong><span>years shaping customer-facing products</span></article>
    <article><strong>E2E</strong><span>design ownership, discovery to handover</span></article>
    <article><strong>BA</strong><span>booking, payments, CMS and production</span></article>
  </div></section>
  <section class="approach wrapper" aria-labelledby="approach-title">
    <div class="section-heading"><p class="kicker"><span></span> What I bring</p><h2 id="approach-title">The translator between ambition and execution.</h2></div>
    <div class="capabilities">
      <article><span class="index">01</span><div><h3>Shape the system</h3><p>I turn broad requirements into pragmatic architecture, clean boundaries, and decisions teams can confidently build from.</p></div></article>
      <article><span class="index">02</span><div><h3>De-risk the journey</h3><p>I connect frontend, backend, payment, CMS, security, and support concerns before they become delivery blockers.</p></div></article>
      <article><span class="index">03</span><div><h3>Move teams forward</h3><p>I create clear slices, surface dependencies, and stay close enough to engineering to carry intent all the way into production.</p></div></article>
    </div>
  </section>
  <section class="work-section" id="selected-work" aria-labelledby="work-title"><div class="wrapper">
    <div class="work-heading"><div><p class="kicker kicker-light"><span></span> Selected work</p><h2 id="work-title">Proof in the work.</h2></div><a href="/work/">View all projects <Icon icon="arrow-right" size="1em" /></a></div>
    <ul class="project-grid">{projects.map((project) => <li><PortfolioPreview project={project} /></li>)}</ul>
  </div></section>
  <section class="contact-band wrapper" aria-labelledby="contact-title">
    <p class="kicker"><span></span> Let’s build something useful</p>
    <div class="contact-row"><h2 id="contact-title">Have a complex problem<br />that needs a clear path?</h2><a class="round-link" href="mailto:pulkitkakkar176@gmail.com" aria-label="Email Pulkit"><Icon icon="arrow-right" size="2em" /></a></div>
    <div class="contact-links"><a href="mailto:pulkitkakkar176@gmail.com">pulkitkakkar176@gmail.com</a><a href="https://www.linkedin.com/in/pulkit-kakkar-b98408b1/">LinkedIn ↗</a><a href="/assets/resume/Pulkit_Kakkar_Technical_Design_Lead_Resume.pdf" download>Download résumé ↓</a></div>
  </section>
</main>
</BaseLayout>
<style>
:global(.backgrounds){background:var(--gray-999)!important} main{overflow:hidden}.hero{display:grid;gap:3rem;min-height:42rem;padding-block:3rem 5rem;align-items:center}.hero-copy{position:relative;z-index:1}.kicker{display:flex;align-items:center;gap:.65rem;margin-bottom:1.5rem;color:var(--gray-300);font-family:var(--font-brand);font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.kicker span{width:2rem;height:2px;background:var(--accent-regular)}h1{max-width:11ch;color:var(--gray-0);font-size:clamp(3.4rem,8vw,7.2rem);font-weight:600;letter-spacing:-.065em;line-height:.91}h1 em{color:var(--accent-dark);font-style:normal}.intro{max-width:42rem;margin-top:2rem;color:var(--gray-300);font-size:clamp(1rem,2vw,1.25rem);line-height:1.65}.hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem;margin-top:2.25rem}.button{display:inline-flex;align-items:center;gap:.7rem;padding:1rem 1.25rem;color:#11130f;background:var(--accent-regular);box-shadow:6px 6px 0 var(--accent-rose);font-family:var(--font-brand);font-weight:700;text-decoration:none;transition:.2s}.button:hover{transform:translate(-2px,-2px);box-shadow:9px 9px 0 var(--accent-rose)}.text-link{color:var(--gray-0);font-family:var(--font-brand);font-weight:600;text-underline-offset:.35rem}.portrait-wrap{position:relative;width:min(82vw,29rem);margin-inline:auto}.portrait-wrap:before{position:absolute;inset:-1rem 1rem 1rem -1rem;z-index:0;content:"";background:var(--accent-rose)}.portrait-wrap img{position:relative;z-index:1;display:block;width:100%;aspect-ratio:4/5;filter:saturate(.8) contrast(1.05);object-fit:cover;object-position:top}.portrait-number{position:absolute;top:-3.2rem;right:-1.5rem;z-index:2;color:var(--accent-dark);font-family:var(--font-brand);font-size:4.5rem;font-weight:700;letter-spacing:-.07em}.portrait-note{position:relative;z-index:2;display:flex;gap:.7rem;width:calc(100% - 1.5rem);margin:-2.5rem 0 0 1.5rem;padding:1rem;color:#f6f1e7;background:#171912;box-shadow:6px 6px 0 var(--accent-regular)}.portrait-note p{font-size:.78rem;line-height:1.45}.status-dot{flex:0 0 auto;width:.55rem;height:.55rem;margin-top:.2rem;border-radius:50%;background:var(--accent-regular);box-shadow:0 0 0 .25rem color-mix(in srgb,var(--accent-regular) 20%,transparent)}.proof{border-block:1px solid var(--gray-800);background:var(--gray-900)}.proof-grid{display:grid}.proof-grid>*{padding:1.4rem 0;border-bottom:1px solid var(--gray-800)}.proof-grid>*:last-child{border:0}.proof-lead{color:var(--gray-0);font-family:var(--font-brand);font-size:1.2rem;font-weight:700;line-height:1.15}.proof-grid article{display:grid;grid-template-columns:5rem 1fr;align-items:center;gap:1rem}.proof-grid strong{color:var(--accent-dark);font-family:var(--font-brand);font-size:2rem;letter-spacing:-.05em}.proof-grid span{max-width:14rem;color:var(--gray-300);font-size:.82rem}.approach{display:grid;gap:3rem;padding-block:6rem}.section-heading h2,.work-heading h2,.contact-row h2{color:var(--gray-0);font-size:clamp(2.5rem,5vw,4.8rem);letter-spacing:-.055em;line-height:.98}.section-heading h2{max-width:10ch}.capabilities article{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding-block:1.7rem;border-top:1px solid var(--gray-800)}.index{color:var(--accent-rose);font-family:var(--font-brand);font-size:.8rem;font-weight:700}.capabilities h3{margin-bottom:.6rem;color:var(--gray-0);font-size:1.4rem}.capabilities p{max-width:36rem;color:var(--gray-400);line-height:1.7}.work-section{padding-block:6rem;color:#f6f1e7;background:#171912}.kicker-light{color:#a6a99c}.work-heading{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:3rem}.work-heading h2{color:#f6f1e7}.work-heading>a{display:inline-flex;align-items:center;gap:.5rem;color:var(--accent-regular);font-family:var(--font-brand);font-weight:700;text-underline-offset:.3rem}.project-grid{display:grid;gap:1.25rem;padding:0;list-style:none}.project-grid :global(.card){border-color:#35372f;border-radius:0;background:#20231c;box-shadow:none}.project-grid :global(.card:hover){border-color:var(--accent-regular);transform:translateY(-4px)}.project-grid :global(.title){color:#f6f1e7}.project-grid :global(.description){color:#a6a99c}.project-grid :global(.tags span){border-color:#41443a;color:#a6a99c}.contact-band{padding-block:6rem 3rem}.contact-row{display:flex;justify-content:space-between;align-items:end;gap:2rem}.contact-row h2{max-width:16ch}.round-link{flex:0 0 auto;display:grid;place-items:center;width:5rem;height:5rem;border-radius:50%;color:#11130f;background:var(--accent-regular);transition:transform .2s}.round-link:hover{transform:rotate(-12deg) scale(1.06)}.contact-links{display:flex;flex-wrap:wrap;gap:1.25rem 2rem;margin-top:4rem;padding-top:1.5rem;border-top:1px solid var(--gray-800)}.contact-links a{color:var(--gray-200);font-size:.9rem;text-underline-offset:.25rem}@media(min-width:50em){.hero{grid-template-columns:minmax(0,1.45fr) minmax(20rem,.75fr);gap:4rem;padding-block:5rem 7rem}.hero-copy{padding-left:2rem}.portrait-wrap{width:100%}.proof-grid{grid-template-columns:1.05fr repeat(3,1fr)}.proof-grid>*{min-height:9rem;padding:2rem;border-right:1px solid var(--gray-800);border-bottom:0}.proof-grid>*:first-child{padding-left:0}.proof-grid article{grid-template-columns:1fr;gap:.35rem;align-content:center}.approach{grid-template-columns:.85fr 1.15fr;gap:6rem;padding-block:9rem}.capabilities article{grid-template-columns:4rem 1fr;padding-block:2.2rem}.project-grid{grid-template-columns:repeat(3,1fr)}.contact-band{padding-block:8rem 4rem}.round-link{width:7rem;height:7rem}}
</style>
